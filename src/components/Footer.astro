---
import site from '../data/site';
---

<footer class="bg-gray-900 text-gray-400 py-6">
  <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
    <div class="flex gap-4">
      {site.social.github && (
        <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      )}
      {site.social.linkedin && (
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-[#0A66C2] hover:text-[#5b9bd5] transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      )}
      <a href={site.substackUrl} target="_blank" rel="noopener noreferrer" class="text-[#FF6719] hover:text-[#ff8a50] transition-colors" aria-label="Substack">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24l9.6-5.244 9.6 5.244V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
      </a>
      {site.email && (
        <a href={`mailto:${site.email}`} class="text-gray-300 hover:text-white transition-colors" aria-label="Email">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </a>
      )}
      {site.social.orcid && (
        <a href={site.social.orcid} target="_blank" rel="noopener noreferrer" class="text-[#A6CE39] hover:text-[#c2e65e] transition-colors" aria-label="ORCID">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-1.847-1.178-3.722-3.853-3.722h-2.466z"/></svg>
        </a>
      )}
      {site.social.openreview && (
        <a href={site.social.openreview} target="_blank" rel="noopener noreferrer" class="text-[#8c1b13] hover:text-[#c4362b] transition-colors" aria-label="OpenReview">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm0 2.4A9.6 9.6 0 0 1 21.6 12 9.6 9.6 0 0 1 12 21.6 9.6 9.6 0 0 1 2.4 12 9.6 9.6 0 0 1 12 2.4zM12 4.8A7.2 7.2 0 0 0 4.8 12 7.2 7.2 0 0 0 12 19.2 7.2 7.2 0 0 0 19.2 12 7.2 7.2 0 0 0 12 4.8zm0 2.4a4.8 4.8 0 0 1 4.8 4.8 4.8 4.8 0 0 1-4.8 4.8A4.8 4.8 0 0 1 7.2 12 4.8 4.8 0 0 1 12 7.2z"/></svg>
        </a>
      )}
    </div>
  </div>
</footer>
