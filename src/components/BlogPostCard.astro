---
interface Props {
  title: string;
  date: string;
  excerpt?: string;
  url: string;
  isExternal?: boolean;
}

const { title, date, excerpt, url, isExternal = false } = Astro.props;
---

<a
  href={url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="block p-4 bg-white rounded-lg shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-lg hover:text-blue-600 transition-colors">{title}</h3>
    {isExternal && (
      <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    )}
  </div>
  <p class="text-gray-500 text-sm mt-1">{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
  {excerpt && <p class="text-gray-600 text-sm mt-2 line-clamp-2">{excerpt}</p>}
</a>
